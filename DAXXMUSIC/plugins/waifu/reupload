# ─────────────────────────────────────────────────
#  /reupload <id1> <id2> <id3> ...
#
#  Flow for each ID:
#   1. Fetch existing (broken) img_url from DB
#   2. Bot sends_photo with that URL to CHARA_CHANNEL_ID
#      → Telegram downloads from its cache
#   3. Bot downloads the photo via Telegram file_id
#   4. Re-uploads to ImgBB → gets fresh URL
#   5. Updates img_url in DB (matched by exact stored id)
#   6. Deletes the temp Telegram message
# ─────────────────────────────────────────────────


def upload_to_imgbb(file_path: str) -> str:
    """Upload a local file to ImgBB trying multiple API keys on failure."""
    errors = []
    for idx, api_key in enumerate(IMGBB_API_KEYS):
        try:
            with open(file_path, "rb") as f:
                response = requests.post(
                    UPLOAD_API,
                    data={"key": api_key},
                    files={"image": f},
                    timeout=60,
                )
            if response.status_code == 200:
                data = response.json()
                if data.get("success"):
                    return data["data"]["url"]
                else:
                    errors.append(f"Key {idx} returned success=False: {data.get('error', {}).get('message', 'Unknown Error')}")
            else:
                errors.append(f"Key {idx} failed with status {response.status_code}: {response.text}")
        except Exception as e:
            errors.append(f"Key {idx} exception: {e}")
            
    raise Exception(f"All ImgBB keys failed to upload. Errors: {'; '.join(errors)}")


async def find_char(char_id: str):
    """
    Try multiple ID formats because MongoDB may store as string "60"
    or zero-padded "60" or integer 60.
    """
    # Try as-is string
    char = await collection.find_one({"id": char_id})
    if char:
        return char

    # Try zero-padded string e.g. "60" → already tried, try "060"
    padded = char_id.zfill(2)
    if padded != char_id:
        char = await collection.find_one({"id": padded})
        if char:
            return char

    # Try integer
    try:
        char = await collection.find_one({"id": int(char_id)})
        if char:
            return char
    except ValueError:
        pass

    return None


@ZYRO.on_message(filters.command(["reupload"]))
@require_power("add_character")
async def reupload_handler(client, message):
    """
    Usage:
      /reupload 60
      /reupload 30 60 61 100
    """
    args = message.text.split()[1:]

    if not args:
        return await message.reply_text(
            "❌ **Wrong format!**\n\n"
            "Usage:\n"
            "`/reupload 60`\n"
            "`/reupload 30 60 61 100`"
        )

    status_msg = await message.reply_text(
        f"⏳ Processing **{len(args)}** character(s)…"
    )

    results = []
    success = 0
    fail    = 0

    for char_id in args:
        char_id  = char_id.strip()
        path     = None
        sent_msg = None

        try:
            # ── Step 1: Find character in DB ───────
            char = await find_char(char_id)
            if not char:
                results.append(f"❌ `{char_id}` — not found in DB")
                fail += 1
                continue

            stored_id = char.get("id")           # exact value stored in DB
            name      = char.get("name", "?")
            old_url   = char.get("img_url", "")

            if not old_url:
                results.append(f"❌ `{char_id}` ({name}) — no img_url in DB")
                fail += 1
                continue

            # ── Step 2: Send photo to CHARA_CHANNEL_ID ─────────
            # Telegram fetches image from its cache using the old URL
            try:
                sent_msg = await client.send_photo(
                    chat_id=CHARA_CHANNEL_ID,
                    photo=old_url,
                    caption=f"#reupload id:{char_id}"
                )
            except Exception as send_err:
                results.append(f"❌ `{char_id}` ({name}) — Telegram send failed: `{str(send_err)[:80]}`")
                fail += 1
                continue

            # ── Step 3: Download from Telegram ─────
            tmp_file = f"/tmp/reupload_{char_id}.jpg"
            os.makedirs("/tmp", exist_ok=True)
            path = await client.download_media(
                sent_msg.photo.file_id,
                file_name=tmp_file
            )

            if not path or not os.path.exists(path):
                raise Exception("Download from Telegram returned empty file")

            file_size = os.path.getsize(path)
            if file_size < 100:
                raise Exception(f"Downloaded file too small ({file_size} bytes) — image may be invalid")

            # ── Step 4: Upload to ImgBB ──────────
            new_url = upload_to_imgbb(path)

            # ── Step 5: Update MongoDB ─────────────
            # Match using the exact stored_id value (preserves original type)
            update_result = await collection.update_one(
                {"id": stored_id},
                {"$set": {"img_url": new_url, "status": "working"}}
            )

            if update_result.matched_count == 0:
                raise Exception(f"DB match failed for id={stored_id!r} (type={type(stored_id).__name__})")

            if update_result.modified_count == 0:
                results.append(f"⚠️ `{char_id}` ({name}) — matched but not modified (same URL?)")
            else:
                results.append(f"✅ `{char_id}` **{name}**\n   └ `{new_url}`")
                success += 1

        except Exception as e:
            results.append(f"❌ `{char_id}` — `{str(e)[:120]}`")
            fail += 1

        finally:
            # Delete temp Telegram message
            if sent_msg:
                try:
                    await sent_msg.delete()
                except Exception:
                    pass
            # Delete local file
            if path and os.path.exists(path):
                try:
                    os.remove(path)
                except Exception:
                    pass

            # Small delay to avoid flood
            await asyncio.sleep(0.5)

    # ── Final summary ─────────────────────────────
    summary = "\n".join(results)
    await status_msg.edit(
        f"**📦 Reupload Complete**\n"
        f"✅ Success: **{success}**  |  ❌ Failed: **{fail}**\n\n"
        f"{summary}"
    )

# ── Background startup task to auto-reupload broken characters ──
async def auto_reupload_on_startup():
    await asyncio.sleep(15)  # Wait for Pyrogram client initialization
    
    # Wait until bot is connected
    while not ZYRO.is_connected:
        await asyncio.sleep(3)
        
    print(f"[REUPLOAD] Startup task: Checking {len(BROKEN_IDS)} target character IDs...")
    
    for char_id in BROKEN_IDS:
        char_id_str = str(char_id)
        path = None
        sent_msg = None
        
        try:
            char = await find_char(char_id_str)
            if not char:
                continue
            
            stored_id = char.get("id")
            name = char.get("name", "?")
            old_url = char.get("img_url", "")
            
            if not old_url:
                continue
                
            # If status is already working or it's a freshly updated ImgBB URL, skip it
            if char.get("status") == "working" or "imgbb.com" in old_url:
                continue

            print(f"[REUPLOAD] Auto-Reuploading: {char_id} ({name})...")
            
            # Send photo to channel to fetch cache
            sent_msg = await ZYRO.send_photo(
                chat_id=CHARA_CHANNEL_ID,
                photo=old_url,
                caption=f"#auto_reupload id:{char_id}"
            )
            
            tmp_file = f"/tmp/auto_reupload_{char_id}.jpg"
            os.makedirs("/tmp", exist_ok=True)
            path = await ZYRO.download_media(
                sent_msg.photo.file_id,
                file_name=tmp_file
            )
            
            if path and os.path.exists(path) and os.path.getsize(path) >= 100:
                new_url = upload_to_imgbb(path)
                await collection.update_one(
                    {"id": stored_id},
                    {"$set": {"img_url": new_url, "status": "working"}}
                )
                print(f"[REUPLOAD] Completed: {char_id} ({name}) -> {new_url}")
            
        except Exception as e:
            print(f"[REUPLOAD] Failed auto-reupload for ID {char_id}: {e}")
        finally:
            if sent_msg:
                try:
                    await sent_msg.delete()
                except Exception:
                    pass
            if path and os.path.exists(path):
                try:
                    os.remove(path)
                except Exception:
                    pass
            await asyncio.sleep(1.0)  # Rate limit safety sleep

# Schedule background startup task
asyncio.create_task(auto_reupload_on_startup())
